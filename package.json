{
  "name": "autotweet",
  "version": "1.0.0",
  "description": "AI-powered content workspace for X. Plan, create, and publish content that sounds like you.",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "dev": "nodemon server/server.js",
    "client": "npm start --prefix client",
    "client:build": "npm run build --prefix client",
    "client:install": "npm install --prefix client",
    "install:all": "npm install && npm install --prefix client",
    "dev-full": "concurrently \"npm run dev\" \"npm run client\"",
    "test": "jest --coverage",
    "test:watch": "jest --watch"
  },
  "keywords": [
    "twitter",
    "automation",
    "scheduling",
    "engagement",
    "social-media"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "axios": "^1.15.2",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-session": "^1.17.3",
    "express-validator": "^7.0.1",
    "firebase-admin": "^11.11.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "node-cron": "^3.0.3",
    "openai": "^6.33.0",
    "session-file-store": "^1.5.0",
    "twitter-api-v2": "^1.15.2",
    "uuid": "^9.0.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3"
  }
}
